# Copy to .env and fill in. Never commit the real file.

# --- required -------------------------------------------------------------
# eBay developer keys (Production keyset: App ID and Cert ID), developer.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Scoring uses Claude. An Anthropic API key from console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: which Claude model scores listings. Leave empty for the CLI's default.
# A smaller model (for example claude-haiku-5-5) costs much less per run.
CLAUDE_MODEL=
# Any long random string. The Home Assistant integration asks for the same one.
API_TOKEN=

# --- alerts (pick one or both) ---------------------------------------------
# Home Assistant: a long-lived access token and the notify service for your phone
HA_URL=
HA_TOKEN=
HA_NOTIFY_SERVICE=
# or an ntfy topic, e.g. https://ntfy.sh/my-secret-topic
NTFY_URL=

# --- optional ----------------------------------------------------------------
# Gmail, read-only over IMAP with an app password: keeps the inventory in sync
# from your eBay and Gixen emails
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Gixen: shows your scheduled snipes (read-only; the bot never changes one)
GIXEN_USER=
GIXEN_PASS=
# Your ZIP code, for accurate shipping costs in search results
EBAY_ZIP=
# Time zone for quiet hours, schedules and times in alerts
SNIPEHUNT_TZ=America/New_York
# Where your weekly reports can be read on the web, if anywhere (ends in /)
REPORTS_URL=
# Uptime Kuma push monitor
KUMA_PUSH_URL=
